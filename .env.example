# ── Acceso al panel ─────────────────────────────────────────────
# Contraseña de administración: todo el panel (importar, enviar, ajustes).
ADMIN_PASSWORD=cambia-esto-por-una-contraseña-larga
# Contraseña de portero: solo escáner y búsqueda por nombre.
DOORMAN_PASSWORD=otra-contraseña-para-la-puerta
# Firma de la cookie de sesión. Genera una con:  openssl rand -hex 32
SESSION_SECRET=

# URL pública de la app. El QR apunta a  <PUBLIC_BASE_URL>/i/<token>
PUBLIC_BASE_URL=https://invitaciones.urbby.app

# ── Evolution API (WhatsApp) ────────────────────────────────────
# Si Evolution corre en el mismo Dokploy puedes usar la URL interna del servicio.
EVOLUTION_URL=https://evolution.tu-dominio.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# Secreto que va en la URL del webhook. Genera uno con:  openssl rand -hex 16
WEBHOOK_SECRET=
# Número secundario desde el que se envía, tal como se lee en el correo.
SENDER_PHONE_DISPLAY=+503 0000 0000

# ── Telnyx (WhatsApp por la API oficial, opcional) ─────────────
# Plantillas de marketing aprobadas por Meta: el número no se bloquea por enviar en automático.
# Convive con Evolution: el canal se elige al empezar cada campaña. Cada mensaje de marketing tiene costo.
TELNYX_API_KEY=
# Número de WhatsApp de tu cuenta de WhatsApp Business conectada a Telnyx.
TELNYX_WHATSAPP_FROM=+503 0000 0000
# ID de la cuenta de WhatsApp Business (WABA): se necesita para crear las plantillas desde el panel.
TELNYX_WABA_ID=
# Portal de Telnyx → Keys & Credentials → Public Key. Sin ella no llegan los estados de entrega y lectura.
TELNYX_PUBLIC_KEY=
# Tope diario de mensajes por Telnyx (Meta empieza con un límite de personas distintas al día).
# TELNYX_DAILY_CAP=250

# ── Resend (correo) ─────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Urbby <invitaciones@urbby.app>
EMAIL_REPLY_TO=soporte@urbby.app

# ── Base de datos (Postgres) ────────────────────────────────────
# Contraseña de Postgres. docker-compose arma DATABASE_URL solo; cámbiala en producción.
POSTGRES_PASSWORD=cambia-esta-clave-de-postgres
# Solo para correr la app fuera de Docker (npm run dev) contra el Postgres del compose:
DATABASE_URL=postgres://urbby:cambia-esta-clave-de-postgres@localhost:5440/invitaciones

# ── Sistema ─────────────────────────────────────────────────────
TZ=America/El_Salvador
PORT=3000
# Solo en desarrollo: puerto de la API si otra herramienta ya fijó PORT para Vite.
# API_PORT=3000
# Caché de tarjetas generadas (se puede borrar: se regeneran solas).
DATA_DIR=./data
